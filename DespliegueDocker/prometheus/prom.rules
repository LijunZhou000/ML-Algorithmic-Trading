groups:
- name: test_metrics_and_logs
  rules:
  - alert: HighRandomGauge
    expr: test_random_gauge > 85
    for: 0m
    labels:
      severity: warning
    annotations:
      summary: "Random gauge demasiado alto"
      description: "La métrica test_random_gauge supera 90 (valor: {{ $value }})"

  - alert: CriticalLogsDetected
    expr: rate(log_errors_total[1m]) > 0
    for: 0m
    labels:
      severity: critical
    annotations:
      summary: "Logs críticos detectados"
      description: "Se han detectado logs de nivel ERROR por parte del generador. Valor: {{ $value }}"

  - alert: SQLMetricAvgTooHigh
    expr: demo_metrics_avg_last_n{metric_name="demo_metric"} > 40
    for: 0m
    labels:
      severity: critical
    annotations:
      summary: "Media de últimas 10 filas de {{ $labels.metric_name }} alta"
      description: "La media es {{ $value }} (umbral 100)"
