global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'job']
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 1h
  # Por defecto envía a Slack (configurada via SLACK_WEBHOOK_URL en .env)
  receiver: 'slack'

  routes:
    # Las alertas con label 'severity: critical' se envían al webhook
    - match:
        severity: 'critical'
      receiver: 'slack'

receivers:
  - name: 'slack'
    slack_configs:
      - api_url: '${SLACK_WEBHOOK_URL}'
        # Si quieres usar un canal diferente, define SLACK_CHANNEL en .env
        channel: '${SLACK_CHANNEL}'
        # Si dejas SLACK_DEFAULT_TEXT vacío, Alertmanager usará su plantilla por defecto
        # text: '${SLACK_DEFAULT_TEXT}'

  - name: 'webhook'
    webhook_configs:
      - url: '${WEBHOOK_URL}'

  - name: 'discord'
    webhook_configs:
      - url: 'https://discordapp.com/api/webhooks/YOUR_DISCORD_WEBHOOK_URL'

  - name: 'email'
    email_configs:
      - to: 'your-email@example.com'
        from: 'alertmanager@example.com'
        smarthost: 'smtp.example.com:587'
        auth_username: 'your-smtp-username'
        auth_password: 'your-smtp-password'
        auth_identity: 'your-email@example.com'

# Nota: reemplaza la variable WEBHOOK_URL por la URL que quieras usar.
# Este archivo es una plantilla: el contenedor de Alertmanager lo procesará con
# envsubst y generará la configuración final antes de arrancar Alertmanager.
