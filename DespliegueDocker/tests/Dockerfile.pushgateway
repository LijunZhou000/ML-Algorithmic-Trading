FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install ca-certificates so HTTPS works inside the container
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY pushgateway_generator.py /app/pushgateway_generator.py

# By default push to the `pushgateway` hostname on the compose network
CMD ["python", "/app/pushgateway_generator.py", "--interval", "5", "--pushgateway", "http://pushgateway:9091", "--job", "test_job"]
