FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_sql_writer.txt /tmp/requirements.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY sql_writer.py /app/sql_writer.py

CMD ["python", "/app/sql_writer.py", "--host", "postgres", "--db", "airflow", "--user", "airflow", "--password", "airflow", "--interval", "60"]
